# ===== Required =====
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY
# The WordPress site to answer questions about (no trailing slash)
BLOG_URL=https://your-blog.example.com
# Sites allowed to call the chatbot API. Several origins can be separated by commas.
ALLOWED_ORIGIN=https://your-blog.example.com
# Where visitors will reach the chatbot (your web server proxies this address to the app).
# A dedicated (sub)domain:  https://chatbot.your-blog.com     or a path on your site:  https://your-blog.com/chatbot
# It is used to write ready-made web server configs into ./webserver/ and to print the widget snippet.
PUBLIC_URL=https://chatbot.example.com

# ===== Models (check the exact IDs available to your key) =====
GEN_MODEL=gemini-3.5-flash-lite
EMB_MODEL=gemini-embedding-2
# Fallback models (comma separated), used when GEN_MODEL is out of daily quota, rate
# limited or failing. Google counts free-tier quota separately for each model, so one
# fallback roughly doubles the AI answers per day. An ID your key cannot use is
# detected and skipped automatically. Leave empty (GEN_FALLBACK_MODELS=) to disable.
GEN_FALLBACK_MODELS=gemini-3.1-flash-lite

# ===== Content =====
# WordPress REST types to index. Add pages with: posts,pages
WP_TYPES=posts
# Several sites / languages in one chatbot (for example a translated copy of the site).
# Format: language=URL, comma separated. When set, it replaces BLOG_URL for indexing,
# and answers prefer links in the language of the page the widget runs on.
# SITES=en=https://your-blog.example.com,vi=https://vi.your-blog.example.com

# ===== Optional (defaults are sensible; remove the leading # to change) =====
# Do not put comments on the same line as a value.
# Name used in answers and in the widget subtitle. Defaults to the host name of BLOG_URL.
# SITE_NAME=My Blog
# Language of server messages when the widget does not send one: en or vi
# DEFAULT_LANG=en
# Local port of the app (it listens on 127.0.0.1 only; your web server proxies to it)
# PORT=8000
# Only if your reverse proxy is NOT on this machine (for example a Docker container): the IP allowed to set X-Forwarded-For
# FORWARDED_ALLOW_IPS=127.0.0.1
# Daily budget of answers FOR EACH MODEL (Gemini free tier: 500 per day for Flash-Lite models)
# GEN_DAILY_LIMIT=450
# Answers per minute FOR EACH MODEL (free tier: 15)
# GEN_RPM=12
# Questions per minute per visitor
# RATE_PER_MIN=6
# Concurrent Gemini calls
# MAX_INFLIGHT=6
# Passages given to the model per question
# TOPK=5
# Hours to remember answers. Cached answers expire by themselves as soon as their
# source article changes, so a long value is safe.
# CACHE_TTL_HOURS=48
# Version tag of the answer cache. Change it (v2, v3...) to discard every cached answer at
# once, for example after you edit the prompt or change how search is tuned. Letters and digits only.
# CACHE_VER=v1
# Keep the answer cache on disk (answers.db) so restarts and updates do not lose it. 0 = memory only
# PERSIST_CACHE=1
# If answers come back empty, raise this
# GEN_MAX_TOKENS=1024
# Only if the model reports a thinking-related error:
# GEN_THINKING_LEVEL=minimal
# GEN_TEMPERATURE=0.2
# Seconds for one model call, and for the whole fallback chain. Keep GEN_DEADLINE
# well under your proxy read timeout (60 s in the bundled configs); past it the
# visitor gets the related articles instead of waiting longer.
# GEN_TIMEOUT=25
# GEN_DEADLINE=40
# Require a valid Origin header on /chat (1 = yes). Set 0 to test with curl.
# REQUIRE_ORIGIN=1
# Set 0 to keep question text out of the logs
# LOG_QUESTIONS=1
# Reply directly to greetings, thanks, goodbyes, "who are you", "what can you do"...
# (instant, no quota used). 0 = treat them like any other question
# SMALLTALK_REPLIES=1
# Understand follow-up questions ("what about the free one?") using the previous question. 0 = off
# FOLLOWUP_CONTEXT=1
# Candidates pulled from each retrieval source (keyword, vector) before merging
# RETRIEVE_FETCH_N=30
# Standard RRF constant used to merge keyword + vector rankings (smaller = stronger top-rank bias)
# RRF_K=60
# Relative weight of the semantic (vector) vs keyword (BM25) signal when merging
# WEIGHT_VEC=1.0
# WEIGHT_FTS=1.0
# Bonus when the article title contains the question's distinctive words (not generic ones
# such as "plugin" that many titles share). It can also bring in an article that neither
# keyword nor vector search found, and it helps search-only mode (no model to re-rank
# sources) surface the right article first
# TITLE_BOOST=0.25
# Extra bonus when the NAME at the start of the title ("Name - tagline") matches the question,
# so asking about a product or tool finds the article about exactly that
# HEAD_BOOST=0.15
# A word found in more than this share of all titles (and in more than 8 titles) counts as generic
# TITLE_GENERIC_DF=0.08
# Bonus for passages in the same language as the page (only matters with SITES)
# LANG_BOOST=0.2
# Small bonus for newer articles, halving every RECENCY_HALFLIFE_DAYS. 0 = off
# RECENCY_BOOST=0.08
# RECENCY_HALFLIFE_DAYS=365

# ===== Do not change after the first indexing (changing them forces a full re-embed) =====
# CHUNK_SIZE=1800
# EMB_DIM=768
EMB_DIM=3072
